# Phase 1 - Core
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/doctrinally
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-a-secret-at-least-32-chars
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_DOMAIN=localhost:3000

# Phase 3 - Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STANDARD_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=

# Phase 5 - Storage & Background Jobs
BLOB_READ_WRITE_TOKEN=
TRIGGER_SECRET_KEY=

# Phase 6 - AI
OPENAI_API_KEY=

# Website crawling (Firecrawl)
FIRECRAWL_API_KEY=

# Embedded chat widget (Phase 9 — Enterprise feature)
# HMAC secret for the widget's session tokens. Must be at least 32 chars.
# Routine rotation: set EMBED_SIGNING_SECRET_PREVIOUS to the current
# value, then replace EMBED_SIGNING_SECRET with a fresh secret. Both
# are accepted during verification until the old one ages out (30 d).
# Then unset the _PREVIOUS variable.
EMBED_SIGNING_SECRET=generate-a-secret-at-least-32-chars
EMBED_SIGNING_SECRET_PREVIOUS=

# Public URL where the embed loader script is hosted.
# Production: https://widget.doctrinally.ai/embed.js (served from
# Cloudflare R2 via the custom-domain feature, edge-cached).
# Local dev: http://localhost:3000/embed-dev.js (served by the
# Next.js route at src/app/embed-dev.js/route.ts — no credentials
# needed). The admin "Website Chat" snippet renders this URL verbatim.
NEXT_PUBLIC_EMBED_SCRIPT_URL=http://localhost:3000/embed-dev.js

# Cloudflare R2 + cache purge (Production only, set in Vercel project
# env). The postbuild step at scripts/embed-loader/build.mjs uploads
# embed.js to R2 and purges the edge cache on every production deploy.
# See scripts/embed-loader/README.md for setup instructions.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=doctrinallyai
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
EMBED_PUBLIC_BASE_URL=https://widget.doctrinally.ai
